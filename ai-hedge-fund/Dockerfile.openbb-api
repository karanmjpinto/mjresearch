# Optional sidecar: full OpenBB Platform REST API (default :6900) for OpenBB Workspace
# or clients that want the upstream ODP surface alongside MJ Research (:8000).
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir "openbb[yfinance]>=4.7"

EXPOSE 6900

CMD ["openbb-api", "--host", "0.0.0.0", "--port", "6900"]
