# Copy to `.env` and adjust.

# SQLite (default: ./data/fund.db)
# DATABASE_URL=sqlite:////absolute/path/to/fund.db

# --- LLM (default: local Ollama — free, open-source, no API keys) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_TIMEOUT_S=600

# Optional: cloud OpenAI instead of Ollama (install: uv sync --extra openai)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Any OpenAI-compatible gateway works through the same client — set the base URL
# and the model id becomes that gateway's namespaced form. Note the tradeoff the
# local default avoids: research context leaves your machine, and on OpenRouter
# it may transit a third-party inference provider as well as the model vendor.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://investing.themariojude.com
# OPENROUTER_SITE_NAME=MJ Research
# OPENAI_API_KEY=sk-or-v1-...
# LLM_MODEL=anthropic/claude-sonnet-4.5

LLM_MAX_OUTPUT_TOKENS=2500
RESEARCH_MAX_CONTEXT_CHARS=24000

# Optional: point individual pipeline stages at their own model. Unset, every
# stage uses the model above and behaviour is unchanged. Reading a data bundle
# into a structured opinion is bulk work a small model does acceptably;
# reconciling four of those opinions is the one call a person reads.
# Names belong to whichever provider LLM_PROVIDER selects.
# LLM_PERSONA_MODEL=qwen3:8b
# LLM_SYNTHESIS_MODEL=qwen3:30b
# The autoresearch proposer only picks from a fixed catalog — the harness judges
# the idea — so a cheaper model there buys more experiments per hour.
# LLM_PROPOSER_MODEL=qwen3:8b

# When the committee splits materially (conviction spread >= 30, or more than
# two distinct stances), show each analyst the others' anonymized conclusions
# and let it revise or hold before the synthesis runs. Costs a second round of
# calls on contested tickers only. Set false to synthesize the first round.
COMMITTEE_REFINE_ON_DISSENT=true

# FinBERT news sentiment (install: uv sync --extra sentiment)
# NEWS_SENTIMENT_ENABLED=true
# FINBERT_MODEL_ID=ProsusAI/finbert

# Frontend URL for CORS (set to your public URL on Railway)
# FRONTEND_URL=http://localhost:5173

# Sentry (optional — error tracking; create a project at https://sentry.io)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_DSN=   # same DSN as SENTRY_DSN for browser errors (Vite build)
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Production: serve Vite build from FastAPI (Docker / Railway)
# STATIC_DIR=./frontend/dist

# Alpha Vantage (sector performance, optional price) — https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=

# Financial Datasets (optional price/fundamentals fallback) — https://financialdatasets.ai/
# FINANCIAL_DATASETS_API_KEY=
OLLAMA_NUM_CTX=16384

# Your own notes (stage 04, "Your lens") — an Obsidian vault or any folder of
# Markdown. Left unset the stage reports honestly that no vault is connected;
# the rest of the flow is unaffected. Nothing is uploaded and the path is never
# committed: this repository is public, and which folder is a personal detail.
# Which notes count as reusable lenses rather than subjects: config/vault.json
# VAULT_PATH=~/Documents/My Vault

# --- who may spend money on a hosted deployment --------------------------
# Only four routes invoke a model: POST /api/research/check, /api/research/plan,
# /api/simulation/backtest and /api/autoresearch/run. Locally they are free
# (Ollama on this machine), so all three settings below default to off and a
# local checkout needs none of them.
#
# They matter when LLM_PROVIDER=openai, because then those routes bill a real
# account. CORS is not a control here — it restrains browsers and does nothing
# to curl — so a public deployment with these unset is an anonymous LLM proxy
# paid for by whoever deployed it.
#
# Refuse model runs outright. The honest setting for a public site, whose
# landing page already says the analysis runs on the visitor's own machine.
# Checked before the key, so a leaked key cannot re-enable it.
# LLM_ENDPOINTS_ENABLED=false
#
# Or keep them enabled behind a shared secret, sent as the X-API-Key header.
# LLM_ACCESS_KEY=
#
# And cap the spend even for a valid key, per client per hour. 0 disables.
# This is what bounds the damage once a key has leaked.
# LLM_RATE_LIMIT_PER_HOUR=20
