# Absolute origin of the deployed API (no trailing slash), e.g.
#   VITE_API_BASE_URL=https://ai-hedge-fund-production.up.railway.app
#
# Leave this unset for local development: the Vite dev server proxies /api to
# FastAPI on :8000. It is only needed for a static deploy such as GitHub Pages,
# which serves no backend of its own.
VITE_API_BASE_URL=
